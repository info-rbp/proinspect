{
  "name": "proinspect", "private": true, "type": "module",
  "packageManager": "pnpm@10.17.1", "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @proinspect/platform dev",
    "dev:marketing": "pnpm --filter @proinspect/marketing dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write apps packages scripts tests docs database *.json *.yaml",
    "format:check": "prettier --check apps packages scripts tests docs database *.json *.yaml"
  },
  "dependencies": { "react": "^19.1.0", "react-dom": "^19.1.0", "react-router": "^8.0.0", "zod": "^4.0.0" },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0", "@cloudflare/workers-types": "^4.20261006.0",
    "@react-router/dev": "^8.0.0", "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "@tailwindcss/vite": "^4.0.0", "tailwindcss": "^4.0.0", "typescript": "^5.9.0", "vite": "^7.0.0", "wrangler": "^4.0.0", "prettier": "^3.6.0", "@playwright/test": "^1.55.0", "miniflare": "^4.0.0", "esbuild": "^0.25.0"
  }
}
