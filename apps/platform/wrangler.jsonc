{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "proinspect-platform-local",
  "keep_vars": true,
  "main": "worker/app.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://localhost:5173",
    "EMAIL_PROVIDER": "local",
    "OPEN_HOME_SHEET_SYNC_ENABLED": "false",
    "OPEN_HOME_REPORTS_ENABLED": "false",
    "OPEN_HOME_REPORT_EMAIL_PROVIDER": "cloudflare",
    "RENTAL_APPLICATIONS_ENABLED": "true",
    "RENTAL_RETENTION_DRAFT_DAYS": "30",
    "RENTAL_RETENTION_SUBMITTED_DAYS": "180",
    "RENTAL_RETENTION_WITHDRAWN_DAYS": "30",
    "RENTAL_RETENTION_AUTOPURGE_ENABLED": "false",
    "MARKETING_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proinspect-local",
      "database_id": "local-proinspect",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "proinspect-local-documents"
    },
    {
      "binding": "RESTRICTED_DOCUMENTS",
      "bucket_name": "proinspect-local-restricted"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "BookingScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BookingScheduler"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "proinspect-local-events"
      }
    ],
    "consumers": [
      {
        "queue": "proinspect-local-events",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "proinspect-local-events-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/2 * * * *",
      "0 1 * * *"
    ]
  },
  "env": {
    "connected": {
      "name": "proinspect-platform",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://proinspect-platform.delicate-dream-e4c9.workers.dev",
        "MARKETING_ORIGIN": "https://proinspect-platform.delicate-dream-e4c9.workers.dev",
        "EMAIL_PROVIDER": "resend",
        "OPEN_HOME_SHEET_SYNC_ENABLED": "false",
        "OPEN_HOME_REPORTS_ENABLED": "false",
        "OPEN_HOME_REPORT_EMAIL_PROVIDER": "cloudflare",
        "EMAIL_FROM": "info@proinspect.systems",
        "OPERATIONS_EMAIL": "info@proinspect.systems",
        "RESTRICTED_WORKFLOWS_ENABLED": "false",
        "RENTAL_APPLICATIONS_ENABLED": "false",
        "RENTAL_RETENTION_AUTOPURGE_ENABLED": "false",
        "PLATFORM_ORIGIN": "https://proinspect-platform.delicate-dream-e4c9.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "proinspect-platform-data",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS"
        },
        {
          "binding": "RESTRICTED_DOCUMENTS",
          "bucket_name": "proinspect-platform-restricted-documents"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SCHEDULER",
            "class_name": "BookingScheduler"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "EVENTS",
            "queue": "proinspect-platform-events"
          }
        ],
        "consumers": [
          {
            "queue": "proinspect-platform-events",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "proinspect-platform-events-dlq"
          }
        ]
      },
      "migrations": [
        {
          "tag": "cf-v1",
          "new_sqlite_classes": [
            "BookingCoordinator"
          ]
        },
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "BookingScheduler"
          ]
        }
      ],
      "triggers": {
        "crons": [
          "*/2 * * * *",
          "0 1 * * *"
        ]
      }
    }
  }
}