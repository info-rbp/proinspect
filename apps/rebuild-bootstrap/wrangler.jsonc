{
  "name": "proinspect-rebuild",
  "main": "worker.js",
  "compatibility_date": "2026-11-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "APP_ENV": "rebuild-bootstrap"
  }
}
